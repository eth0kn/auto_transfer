# Telegram Bot Config
# Shared .env with unified-backend at /var/automate/auto_transfer/.env.
# Add these keys to existing root .env (do NOT create separate .env di telegram-bot/).

# =========================================================
# Telegram Bot Credentials
# =========================================================
# Create bot via @BotFather on Telegram, copy token here
TELEGRAM_BOT_TOKEN=REPLACE_ME_WITH_BOTFATHER_TOKEN

# Owner Telegram chat_id (lookup via @userinfobot)
# ONLY identity source for owner — hardcode, no DB fallback
OWNER_CHAT_ID=REPLACE_ME_WITH_NUMERIC_CHAT_ID

# =========================================================
# Backend IPC Credentials
# =========================================================
# Shared secret between bot and backend REST endpoints /api/tg/*
# Generate: openssl rand -hex 32
TG_BOT_API_KEY=REPLACE_ME_WITH_RANDOM_32_HEX_CHARS

# Backend URL (local loopback since mono-repo dual-process on same VPS)
BACKEND_URL=http://127.0.0.1:3010

# =========================================================
# Shared with unified-backend (already in root .env)
# =========================================================
# DB_HOST=localhost
# DB_USER=auto_transfer
# DB_PASSWORD=xxxxx
# DB_NAME=auto_transfer_db_unified

# =========================================================
# Runtime Defaults
# =========================================================
# Confirmation TTL (destructive ops + alias ambiguity picker). Matches
# user-visible "Confirm within Ns" text in /delete reply.
TG_CONFIRM_TTL_SEC=60
# Rate limit destructive per chat_id (not yet enforced; reserved)
TG_RATE_LIMIT_PER_MIN=10
# Wizard session timeout
TG_WIZARD_TIMEOUT_MIN=15
# Audit log retention (enforced by hourly cron di telegram-bot/index.js)
TG_AUDIT_RETENTION_DAYS=90
# Shadow observability default
TG_SHADOW_ENABLED=true
# Shadow filter: all | destructive | errors
TG_SHADOW_FILTER=all
