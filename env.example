# ==========================================================
# auto_transfer — env template
# Copy ke .env dan isi credential aktual. JANGAN commit .env.
# ==========================================================

# --- Backend ---
NODE_ENV=production
PORT=3010

# --- Database (MySQL) ---
DB_HOST=localhost
DB_USER=secure
DB_PASSWORD=change_me
DB_NAME=auto_transfer_db_unified

# --- Auth: X-API-KEY untuk POST /{app}/transfer (external submit) ---
# Opsi shared (Q-04 opsi A di docs/DECISIONS.md):
API_KEY=change_me_strong_random_token

# Opsi per-app (Q-04 opsi B):
# API_KEY_BRIMO=...
# API_KEY_MYBCA=...
# Kalau kedua di-set, ini yang dipakai. Kalau tidak, fallback ke API_KEY.

# --- Auth: Dashboard admin login (cookie session, 4 jam) ---
DASHBOARD_USER=admin
DASHBOARD_PASS=change_me_strong_password

# --- Feature Flags ---
# true = terima juga request tanpa prefix /{app} (default to app_source=brimo)
# Berguna transisi kalau ada bot v3.3.x yang belum upgrade URL.
# Disable-kan begitu semua bot upgrade v3.4.0+ per docs/IMPACT-ASSESSMENT.md.
LEGACY_UNPREFIXED_ROUTES=false

# --- Optional: Custom validation timeout (ms), default 60000 ---
# VALIDATION_TIMEOUT_MS=60000

# --- Optional: Auto-fail PROCESSING task older than N ms (default 180000 = 3 min) ---
# PROCESSING_STALE_MS=180000

# --- Optional: Auto-cancel PENDING task older than N ms (default 600000 = 10 min)
# Antisipasi tumpukan queue kalau bot offline lama.
# PENDING_STALE_MS=600000

# ==========================================================
# 🆕 v4.1.0 — Transfer Status Callback Feature
# Spec: docs/feature-callback-2026-11-01.md
# ==========================================================

# --- Admin API Key: untuk endpoint /api/admin/callbacks/* (stats/dead/replay) ---
# Jangan samakan dengan API_KEY di atas. Set 32+ hex random.
# Tanpa ADMIN_API_KEY → admin endpoints balikin 503 (feature disabled).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change_me_hex_32_bytes

# --- Callback Worker Tuning (semua optional, default fine untuk prod) ---
# Interval scan DB queue PENDING callback (ms). Lower = faster delivery, higher DB load.
# CALLBACK_WORKER_INTERVAL_MS=10000

# Max callback per tick. Prevent runaway load spike.
# CALLBACK_WORKER_BATCH=20

# HTTP request timeout saat POST ke callback_url (ms).
# CALLBACK_TIMEOUT_MS=10000

# Max delivery attempt sebelum DEAD. Backoff 30s → 2m → 10m → 1h ±25% jitter.
# CALLBACK_MAX_ATTEMPTS=5

# Max age sejak PENDING sebelum DEAD (hours). Protect against infinite retry.
# CALLBACK_MAX_AGE_HOURS=24
